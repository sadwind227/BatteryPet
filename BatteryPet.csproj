<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BatteryPet</AssemblyName>
    <Version>0.4.1</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);上传准备/**;artifacts/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <None Update="battery_bridge.py;hid_win.py;read_logitech.py;adapter_tool.py;adapter_runtime.py" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Examples/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
