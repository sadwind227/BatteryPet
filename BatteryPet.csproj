<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeFrameworkVersion>8.0.27</RuntimeFrameworkVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BatteryPet</AssemblyName>
    <Version>0.7.0-dev</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Authors>sadwind227</Authors>
    <Copyright>Copyright (c) 2026 sadwind227</Copyright>
    <Description>Windows peripheral battery monitor and interactive desktop pet.</Description>
    <DefaultItemExcludes>$(DefaultItemExcludes);上传准备/**;发布版/**;build/**;artifacts/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="CHANGELOG.md" LogicalName="BatteryPet.Changelog" />
    <Compile Remove="scripts/installer/**/*.cs" />
    <EmbeddedResource Include="MigrationFixtures.json" LogicalName="BatteryPet.MigrationFixtures.json" />
    <EmbeddedResource Include="AdapterSchema.json" LogicalName="BatteryPet.AdapterSchema.json" />
    <EmbeddedResource Include="AdapterTask.txt" LogicalName="BatteryPet.AdapterTask.txt" />
    <None Update="Examples/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="licenses/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
